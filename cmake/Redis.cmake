enable_language(C)
function(aegis_configure_redis)
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
include(FetchContent)
FetchContent_Declare(queue_hiredis URL https://codeload.github.com/redis/hiredis/tar.gz/refs/tags/v1.3.0
    URL_HASH SHA256=25cee4500f359cf5cad3b51ed62059aadfc0939b05150c1f19c7e2829123631c DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
# Keep dependency options local to this directory; the core remains dependency-free.
set(BUILD_SHARED_LIBS OFF)
set(DISABLE_TESTS ON)
set(ENABLE_EXAMPLES OFF)
set(ENABLE_SSL OFF)
set(ENABLE_NUGET OFF)
FetchContent_MakeAvailable(queue_hiredis)
if(NOT TARGET nlohmann_json::nlohmann_json)
    FetchContent_Declare(queue_json URL https://codeload.github.com/nlohmann/json/tar.gz/9cca280a4d0ccf0c08f47a99aa71d1b0e52f8d03
        URL_HASH SHA256=0dbc5e40a01ff142e7e68c03e85247a4dcede2f592d12d3677dee3664d17975a DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(queue_json)
endif()
endfunction()
aegis_configure_redis()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/deploy/redis/queue.lua" AEGIS_REDIS_SCRIPT)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/deploy/redis/queue.lua")
configure_file(src/redis_script.hpp.in generated/redis_script.hpp @ONLY)
find_package(Threads REQUIRED)
add_library(aegisvision_redis STATIC src/redis_queue.cpp src/redis_worker.cpp)
target_include_directories(aegisvision_redis PUBLIC include PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_compile_features(aegisvision_redis PUBLIC cxx_std_20)
if(MSVC)
    target_compile_options(aegisvision_redis PUBLIC /utf-8)
else()
    target_compile_options(aegisvision_redis PRIVATE -Wall -Wextra -Wpedantic)
endif()
target_link_libraries(aegisvision_redis PUBLIC nlohmann_json::nlohmann_json PRIVATE hiredis::hiredis Threads::Threads)
add_executable(aegisvision_redis_queue apps/redis_queue.cpp)
target_link_libraries(aegisvision_redis_queue PRIVATE aegisvision_redis)
if(AEGISVISION_BUILD_TESTS)
    find_package(Threads REQUIRED)
    add_executable(aegisvision_redis_tests tests/test_redis_queue.cpp)
    target_link_libraries(aegisvision_redis_tests PRIVATE aegisvision_redis Threads::Threads)
    add_test(NAME aegisvision_redis_validation COMMAND aegisvision_redis_tests)
    add_executable(aegisvision_redis_worker_tests tests/test_redis_worker.cpp)
    target_link_libraries(aegisvision_redis_worker_tests PRIVATE aegisvision_redis)
    add_test(NAME aegisvision_redis_worker COMMAND aegisvision_redis_worker_tests)
    set_tests_properties(aegisvision_redis_worker PROPERTIES TIMEOUT 30)
endif()

if(AEGISVISION_WITH_OPENCV)
    if(OpenCV_VERSION VERSION_LESS "4.12.0")
        message(FATAL_ERROR "Redis YOLO worker requires OpenCV >= 4.12.0; distro 4.6 cannot import the reference ONNX model. See docs/redis-queue.md.")
    endif()
    include(FetchContent)
    FetchContent_Declare(search_sha URL https://codeload.github.com/okdshin/PicoSHA2/tar.gz/161cb3fc4170fa7a3eca9e582cebd27cc4d1fe29
        URL_HASH SHA256=6cf473a00c98298d3ddee0aed853e3c799791f49dbc01c996ea46cb248e85802 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(search_sha)
    include(cmake/ImageQueueHttp.cmake)
    add_library(aegisvision_redis_image src/redis_image.cpp)
    target_link_libraries(aegisvision_redis_image PUBLIC aegisvision_redis aegisvision_opencv)
    target_include_directories(aegisvision_redis_image PRIVATE "${search_sha_SOURCE_DIR}")
    add_executable(aegisvision_redis_worker apps/redis_worker.cpp)
    target_link_libraries(aegisvision_redis_worker PRIVATE aegisvision_redis_image)
    aegisvision_runtime(aegisvision_redis_worker)
    add_library(aegisvision_redis_bridge src/redis_image_queue.cpp)
    target_link_libraries(aegisvision_redis_bridge PUBLIC aegisvision_redis_image aegisvision_image_http)
    if(TARGET aegisvision_server)
        target_link_libraries(aegisvision_server PRIVATE aegisvision_redis_bridge)
        target_compile_definitions(aegisvision_server PRIVATE AEGISVISION_SERVICE_REDIS=1)
    endif()
    if(AEGISVISION_BUILD_TESTS)
        add_executable(aegisvision_redis_http_fixture tests/redis_http_fixture.cpp)
        target_link_libraries(aegisvision_redis_http_fixture PRIVATE aegisvision_redis_bridge)
        aegisvision_runtime(aegisvision_redis_http_fixture)
        add_test(NAME aegisvision_redis_worker_help COMMAND aegisvision_redis_worker --help)
    endif()
endif()
