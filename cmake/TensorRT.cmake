    FetchContent_Declare(search_json URL https://codeload.github.com/nlohmann/json/tar.gz/9cca280a4d0ccf0c08f47a99aa71d1b0e52f8d03 URL_HASH SHA256=0dbc5e40a01ff142e7e68c03e85247a4dcede2f592d12d3677dee3664d17975a DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(search_json)
endif()
FetchContent_Declare(search_sha URL https://codeload.github.com/okdshin/PicoSHA2/tar.gz/161cb3fc4170fa7a3eca9e582cebd27cc4d1fe29 URL_HASH SHA256=6cf473a00c98298d3ddee0aed853e3c799791f49dbc01c996ea46cb248e85802 DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
FetchContent_MakeAvailable(search_sha)
add_library(aegisvision_tensorrt src/tensorrt.cpp)
target_include_directories(aegisvision_tensorrt PRIVATE "${search_sha_SOURCE_DIR}")
target_link_libraries(aegisvision_tensorrt PUBLIC aegisvision_opencv nlohmann_json::nlohmann_json
    PRIVATE aegis_nvinfer aegis_nvonnxparser CUDA::cudart)
function(aegis_trt_runtime target)
    aegisvision_runtime(${target})
    if(WIN32)
        # Builder discovers its resource DLL at runtime, outside the link graph.
        file(GLOB _trt_resources "${TENSORRT_ROOT}/lib/nvinfer_builder_resource*.dll" "${TENSORRT_ROOT}/bin/nvinfer_builder_resource*.dll")
        if(NOT _trt_resources)
            message(FATAL_ERROR "TensorRT builder resource DLL missing")
        endif()
        add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
            ${_trt_resources} "${_cuda_runtime_dll}" $<TARGET_FILE_DIR:${target}> COMMAND_EXPAND_LISTS)
    endif()
endfunction()
